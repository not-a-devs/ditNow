# Copy OUTSIDE the checkout, chmod 600. Compose uses raw values, not shell source.
# The public profile is the only default. Existing DEMO/P0 activation is a separate approval.
DIT_API_P0_RUNTIME_ENABLED=false
DIT_API_P0_SCHEMA_APPROVED=false
DIT_API_P0_IDENTITY_APPROVAL_IDS=[]
DIT_API_ASK_RATE_LIMIT_PER_MIN=20
# Approved P0 operator only: copy existing app credentials using protected input, never argv.
# DIT_API_DB_HOST=<approved private host>
# DIT_API_DB_PORT=3307
# DIT_API_DB_NAME=ditnow
# DIT_API_DB_USER=ditnow_app
# DIT_API_DB_PASSWORD=<protected runtime value>
# DIT_API_DB_TLS_CA_FILE=/run/certs/mariadb-ca.pem
# No migrator, DATABASE_URL, LLM key, Tunnel token, fake identity or automatic seed.
