# DIT NOW MariaDB — copy to .env (or run scripts/gen-env.sh) and never commit .env
# ---- non-secret settings ----
DB_IMAGE=mariadb:11.4
DB_CONTAINER_NAME=ditnow-db
DB_BIND_ADDR=127.0.0.1          # keep 127.0.0.1; remote access goes through Tailscale/SSH tunnel
DB_HOST_PORT=3307
DB_SUBNET=172.31.250.0/24       # docker network for this stack; must not overlap other networks
DB_USER_HOST=172.31.250.%       # host pattern for service accounts (matches DB_SUBNET)
DB_MEM_LIMIT=1536m
TZ=Asia/Seoul
BACKUP_RETENTION_DAYS=14
# ---- secrets (gen-env.sh replaces CHANGE_ME with random values) ----
DB_ROOT_PASSWORD=CHANGE_ME
DB_MIGRATOR_PASSWORD=CHANGE_ME
DB_APP_PASSWORD=CHANGE_ME
DB_CHATBOT_PASSWORD=CHANGE_ME
DB_BACKUP_PASSWORD=CHANGE_ME
# ---- TLS (scripts/gen-tls.sh) ----
DB_TLS_SANS=DNS:localhost,IP:127.0.0.1    # add IP:<tailscale-ip>,DNS:<magicdns-name> of the DB server
