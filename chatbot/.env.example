# LLM 공급자: openai | anthropic | openai_compatible | fake
LLM_PROVIDER=openai
LLM_MODEL=
LLM_API_KEY=
# openai_compatible일 때만 (예: 로컬 vLLM, Ollama)
LLM_BASE_URL=
LLM_TIMEOUT_SEC=20

# 기존 독립 시연의 런타임 DML 계정. 실제 접속/GRANT는 별도 확인한다.
# 예시 자리표시자이며 비밀번호/호스트를 저장소에 기록하지 않는다.
DATABASE_URL=mysql+aiomysql://APP_USER:APP_PASSWORD@DB_HOST:3307/ditnow_chatbot?charset=utf8mb4
# 런타임 테이블 생성·자동 시드는 금지한다. true면 설정 오류다.
DB_AUTO_INIT=false
CURRENT_SEMESTER=2026-2

# 검색·프롬프트
MIN_SCORE=0.35
TOP_K=5
MAX_CONTEXT_CHARS=3000

# 서버
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ADMIN_TOKEN=
RATE_LIMIT_PER_MIN=20
