# LLM 공급자: openai | anthropic | openai_compatible | fake
LLM_PROVIDER=openai
LLM_MODEL=
LLM_API_KEY=
# openai_compatible일 때만 (예: 로컬 vLLM, Ollama)
LLM_BASE_URL=
LLM_TIMEOUT_SEC=20

# DB (docker compose up -d 로 띄운 MariaDB)
DATABASE_URL=mysql+aiomysql://ditnow:ditnow@localhost:3306/ditnow?charset=utf8mb4
MARIADB_PASSWORD=ditnow
MARIADB_ROOT_PASSWORD=ditnow-root
# 시작 시 테이블 생성 + 비어 있으면 data/mock 시드
DB_AUTO_INIT=true
CURRENT_SEMESTER=2026-2

# 검색·프롬프트
MIN_SCORE=0.35
TOP_K=5
MAX_CONTEXT_CHARS=3000

# 서버
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ADMIN_TOKEN=
RATE_LIMIT_PER_MIN=20
