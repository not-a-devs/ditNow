# OS 환경에 명시적으로 설정합니다. 앱은 .env를 자동 읽지 않습니다.
DIT_API_ENVIRONMENT=development
DIT_API_LOG_LEVEL=INFO
DIT_API_CORS_ORIGINS=["http://localhost:5173"]
DIT_API_DOCS_ENABLED=true

# P0 business runtime stays disabled until explicit account/runtime approval.
# Review the two audit-log UUIDs returned by the approved DEMO operation;
# never substitute a student UUID or the disabled audit actor UUID.
DIT_API_P0_RUNTIME_ENABLED=false
DIT_API_P0_SCHEMA_APPROVED=false
DIT_API_P0_IDENTITY_APPROVAL_IDS=[]
# The shared per-IP limit also covers login/me/logout. An isolated local E2E
# quota or pacing must be explicitly approved; do not change production by default.
DIT_API_ASK_RATE_LIMIT_PER_MIN=20

# Optional DB settings are NOT loaded automatically. Do not commit real values.
# Configure HOST/USER/PASSWORD together only after operational approval.
# DIT_API_DB_HOST=db.private.invalid
# DIT_API_DB_PORT=3307
# DIT_API_DB_NAME=ditnow
# DIT_API_DB_USER=ditnow_app
# DIT_API_DB_PASSWORD=<set-through-secret-manager>
# DIT_API_DB_CONNECT_TIMEOUT=5
# Optional custom CA; certificate/hostname verification cannot be disabled.
# DIT_API_DB_TLS_CA_FILE=/absolute/path/to/approved-ca.pem
