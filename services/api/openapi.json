                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Resource Version"
          },
          "server_time": {
            "format": "date-time",
            "title": "Server Time",
            "type": "string"
          }
        },
        "required": [
          "data"
        ],
        "title": "SuccessResponse[HealthData]",
        "type": "object"
      }
    }
  },
