      "CampusSearchData": {
        "additionalProperties": false,
        "properties": {
          "found": {
            "title": "Found",
            "type": "boolean"
          },
          "generated": {
            "const": false,
            "default": false,
            "title": "Generated",
            "type": "boolean"
