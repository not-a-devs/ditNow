{
  "components": {
    "schemas": {
      "AskData": {
        "additionalProperties": false,
        "properties": {
          "answer": {
            "title": "Answer",
            "type": "string"
          },
          "classified_by": {
            "enum": [
              "keyword",
              "llm"
            ],
            "title": "Classified By",
            "type": "string"
          },
          "found": {
            "title": "Found",
            "type": "boolean"
          },
          "generated": {
            "const": true,
            "default": true,
            "title": "Generated",
            "type": "boolean"
          },
          "intent": {
            "title": "Intent",
            "type": "string"
          },
          "locations": {
            "items": {
              "$ref": "#/components/schemas/AskLocation"
            },
            "title": "Locations",
            "type": "array"
          },
          "need_login": {
            "title": "Need Login",
            "type": "boolean"
          },
          "personal_data_access": {
            "title": "Personal Data Access",
            "type": "boolean"
          },
          "record_source": {
            "const": "DEMO",
            "default": "DEMO",
            "title": "Record Source",
            "type": "string"
          },
          "rewritten_question": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rewritten Question"
          },
          "sources": {
            "items": {
              "type": "string"
            },
            "title": "Sources",
            "type": "array"
          }
        },
        "required": [
          "answer",
          "sources",
          "locations",
          "found",
          "intent",
          "need_login",
          "classified_by",
          "personal_data_access"
        ],
        "title": "AskData",
        "type": "object"
      },
      "AskInput": {
        "additionalProperties": false,
        "properties": {
          "history": {
            "items": {
              "$ref": "#/components/schemas/AskTurn"
            },
            "maxItems": 6,
            "title": "History",
            "type": "array"
          },
          "question": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Question",
            "type": "string"
          }
        },
        "required": [
          "question"
        ],
        "title": "AskInput",
        "type": "object"
      },
      "AskLocation": {
        "additionalProperties": false,
        "properties": {
          "building": {
            "title": "Building",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "lat": {
            "title": "Lat",
            "type": "number"
          },
          "lng": {
            "title": "Lng",
            "type": "number"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "building",
          "lat",
          "lng"
