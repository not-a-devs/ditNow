{
  "components": {
    "schemas": {
      "ErrorCode": {
        "enum": [
          "VALIDATION",
          "UNAUTHORIZED",
          "FORBIDDEN",
          "NOT_FOUND",
          "CONFLICT",
          "RATE_LIMITED",
          "UNAVAILABLE",
          "INTERNAL",
          "HTTP_ERROR"
        ],
        "title": "ErrorCode",
        "type": "string"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "field_errors": {
