          "hits": {
            "items": {
              "$ref": "#/components/schemas/CampusSearchHit"
            },
            "title": "Hits",
            "type": "array"
          },
          "mode": {
            "const": "retrieval_only",
            "default": "retrieval_only",
            "title": "Mode",
            "type": "string"
          },
          "personal_data_access": {
            "const": false,
            "default": false,
            "title": "Personal Data Access",
            "type": "boolean"
          },
          "source": {
            "const": "chatbot/data/facilities.json",
            "default": "chatbot/data/facilities.json",
            "title": "Source",
            "type": "string"
          },
          "source_notice": {
            "default": "기존 챗봇 시설 스냅샷이며 공식 출처와 최신성은 검증되지 않았습니다.",
