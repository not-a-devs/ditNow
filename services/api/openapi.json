          },
          "category": {
            "title": "Category",
            "type": "string"
          },
          "floor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Floor"
          },
          "hours": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Hours"
          },
          "matched_by": {
            "enum": [
              "alias",
              "fuzzy",
              "keyword"
            ],
            "title": "Matched By",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "room": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Room"
          },
          "score": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Score",
            "type": "number"
          },
          "source_id": {
            "title": "Source Id",
            "type": "string"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "source_id",
          "name",
          "category",
          "text",
          "score",
          "matched_by"
        ],
        "title": "CampusSearchHit",
        "type": "object"
      },
      "ErrorCode": {
        "enum": [
          "VALIDATION",
          "UNAUTHORIZED",
          "FORBIDDEN",
          "NOT_FOUND",
          "CONFLICT",
          "RATE_LIMITED",
          "UNAVAILABLE",
