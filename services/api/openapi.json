            "type": "string"
          },
          "verification": {
            "const": "UNKNOWN",
            "default": "UNKNOWN",
            "title": "Verification",
            "type": "string"
          }
        },
        "required": [
          "found",
          "hits"
        ],
        "title": "CampusSearchData",
        "type": "object"
      },
      "CampusSearchHit": {
        "additionalProperties": false,
        "properties": {
          "building": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
